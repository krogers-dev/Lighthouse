{
  "name": "hive-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "10.9.8",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:scripts": "node --test \"tests/scripts/*.test.mjs\"",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "supabase:local": "node scripts/local-supabase.mjs",
    "db:types": "node scripts/db-types.mjs generate",
    "db:types:check": "node scripts/db-types.mjs check",
    "config:check": "node scripts/candidate-config-check.mjs",
    "bundle:inspect": "node scripts/bundle-inspect.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "expo": "57.0.11",
    "expo-build-properties": "57.0.13",
    "expo-constants": "57.0.13",
    "expo-file-system": "57.0.5",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.15",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "57.0.7",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "expo-doctor": "1.20.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "supabase": "2.115.0",
    "typescript": "6.0.3"
  }
}
